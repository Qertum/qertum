{
  "LifecycleEvents": {
    "DiagnosticRetentionDays": 30,
    "BufferingTimeLimitMs": 500
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Acme": {
    "RateLimits": {
      "PollingPermitLimit": 300,
      "PollingWindowSeconds": 60,
      "WritePermitLimit": 20,
      "WriteWindowSeconds": 60
    },
    "Dns01": {
      "Enabled": true,
      "Resolvers": [],
      "QueryTimeoutSeconds": 5
    }
  }
}
