{
  "LifecycleEvents": {
    "DiagnosticRetentionDays": 30,
    "BufferingTimeLimitMs": 500
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Est": {
    "RequireHttps": true,
    "RateLimits": {
      "PermitLimit": 20,
      "WindowSeconds": 60
    }
  }
}
