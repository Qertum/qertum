{
  "PqcExceptions": {
    "MaxDays": 365
  },
  "WebhookDestinationPolicy": {
    "PublicMode": "AnyPublic",
    "Rules": []
  },
  "LifecycleEvents": {
    "DiagnosticRetentionDays": 30,
    "BufferingTimeLimitMs": 500
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "RateLimiting": {
    "PermitLimit": 100,
    "WindowSeconds": 60,
    "QueueLimit": 10
  },
  "Identity": {
    "Authority": "",
    "Audience": "qertum-api",
    "RequireHttpsMetadata": true,
    "NameClaimType": "preferred_username",
    "RoleClaimType": "role",
    "ScopeClaimType": "scope",
    "StepUp": {
      "Enabled": false,
      "AcrValues": "mfa",
      "MaxAgeSeconds": 300,
      "AcrClaimType": "acr",
      "AuthTimeClaimType": "auth_time"
    }
  },
  "Approvals": {
    "GrantWindowMinutes": 15,
    "RequestTtlHours": 24,
    "RetentionDays": 365
  },
  "BulkOperations": {
    "MaxItems": 10000,
    "PreviewTtlMinutes": 60,
    "RetentionDays": 365
  },
  "AuditLog": {
    "File": {
      "Enabled": true,
      "Path": "",
      "RollingInterval": "Day",
      "RetainedFileCountLimit": 365
    },
    "Checkpoint": {
      "Enabled": true,
      "IntervalMinutes": 60,
      "IdentityDirectory": ""
    }
  }
}
