# Required
QERTUM_IMAGE=registry.example.lan:5000/qertum-services:latest
# The public name users type in the browser, exactly (no NAT, DNS alias or other name in between):
# sign-in accepts only this address, and every container must resolve it.
QERTUM_HOST=ca.example.lan
QERTUM_EST_TLS_CERT=/etc/qertum/est/tls.crt
QERTUM_EST_TLS_KEY=/etc/qertum/est/tls.key

# Optional
# QERTUM_DATA=/mnt/user/appdata/qertum   # host path; default is the named volume qertum-data
# QERTUM_SCHEME=https                    # when a proxy terminates TLS for web, identity and api (never acme or est)
# ACME_SCHEME=https                      # only when the acme container terminates TLS itself (see README)
# SEED_ADMIN_PASSWORD=
# TPM_DEVICE=/dev/tpmrm0
# TPM_GROUP=105
