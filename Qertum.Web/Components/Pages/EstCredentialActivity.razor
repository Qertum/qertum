@page "/settings/est/{Id:guid}/activity"
@attribute [Authorize(Policy = AppPermissions.SettingsEdit)]
@inject CertificateRequestsApiClient CertificateRequestsApiClient
@inject NavigationManager Nav

<PageTitle>EST credential activity — Qertum</PageTitle>

<PageHeader>
    <Heading>EST credential <em>activity</em></Heading>
    <Subtitle>
                Refused logins and enrollments for this credential. Refusals for usernames that match no
                credential are not recorded. <a href="/settings?section=est">Back to EST settings</a>
            </Subtitle>
</PageHeader>

<div class="form-card animate-in">
    @if (loadFailed)
    {
        <p class="text-muted mb-0" data-test="est-activity-unavailable">Activity is unavailable right now.</p>
    }
    else if (notFound)
    {
        <p class="text-muted mb-0" data-test="est-activity-not-found">No EST credential with this id.</p>
    }
    else if (result is null)
    {
        <p class="text-muted mb-0">Loading…</p>
    }
    else
    {
        <DiagnosticEntryList Entries="result.Items" />
        <Pager Page="@CurrentPage" PageSize="PageSize" TotalCount="@result.TotalCount" OnPageChange="GoToPageAsync" />
    }
</div>

@code {
    private const int PageSize = 50;

    [Parameter] public Guid Id { get; set; }
    [SupplyParameterFromQuery(Name = "page")] public int? PageNumber { get; set; }

    private int CurrentPage => Math.Max(1, PageNumber ?? 1);
    private PagedResult<TimelineEntry>? result;
    private bool loadFailed;
    private bool notFound;

    protected override async Task OnParametersSetAsync()
    {
        result = null;
        loadFailed = false;
        notFound = false;
        try
        {
            result = await CertificateRequestsApiClient.GetEstCredentialActivityAsync(Id, CurrentPage, PageSize);
            notFound = result is null;
        }
        catch (Exception)
        {
            loadFailed = true;
        }
    }

    private Task GoToPageAsync(int page)
    {
        Nav.NavigateTo(Nav.GetUriWithQueryParameter("page", page > 1 ? page : null));
        return Task.CompletedTask;
    }
}
