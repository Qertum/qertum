@page "/acme/orders"
@attribute [Authorize(Policy = AppPermissions.SettingsEdit)]
@inject CertificateRequestsApiClient CertificateRequestsApiClient
@inject NavigationManager Nav

<PageTitle>ACME orders — Qertum</PageTitle>

<PageHeader>
    <Heading>ACME <em>orders</em></Heading>
    <Subtitle>What each ACME client asked for, and why an order is stuck.</Subtitle>
</PageHeader>

<div class="form-card form-card-full animate-in">
    <div class="form-section">
        <div class="d-flex gap-2 align-items-center mb-3">
            <input class="form-control" style="max-width: 360px;" placeholder="Search by name or account id"
                   @bind="searchText" @bind:event="oninput" @onkeydown="SearchOnEnterAsync" />
            <div class="form-check mb-0">
                <input id="failing-only" class="form-check-input" type="checkbox" checked="@Failing" @onchange="ToggleFailingAsync" />
                <label class="form-check-label" for="failing-only">Failing only</label>
            </div>
        </div>

        @if (loadFailed)
        {
            <p class="text-muted mb-0" data-test="acme-orders-unavailable">ACME orders are unavailable right now.</p>
        }
        else if (result is null)
        {
            <p class="text-muted mb-0">Loading…</p>
        }
        else if (result.Items.Count == 0)
        {
            <p class="text-muted mb-0">No ACME orders match.</p>
        }
        else
        {
            <table class="table">
                <thead><tr><th>Names</th><th>Status</th><th>Created (UTC)</th><th>Last failure</th></tr></thead>
                <tbody>
                    @foreach (var order in result.Items)
                    {
                        <tr data-test="acme-order-row">
                            <td><a href="/acme/orders/@order.Id">@string.Join(", ", order.Identifiers)</a></td>
                            <td>@order.Status</td>
                            <td>@order.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm")</td>
                            <td data-test="acme-order-failure">
                                @if (order.LastFailureCategory is not null)
                                {
                                    <span class="timeline-category">@order.LastFailureCategory</span>
                                    <span class="text-muted"> @order.LastFailureDetail</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <Pager Page="@CurrentPage" PageSize="PageSize" TotalCount="@result.TotalCount" OnPageChange="GoToPageAsync" />
        }
    </div>
</div>

@code {
    private const int PageSize = 50;

    [SupplyParameterFromQuery(Name = "search")] public string? Search { get; set; }
    [SupplyParameterFromQuery(Name = "failing")] public bool Failing { get; set; }
    [SupplyParameterFromQuery(Name = "page")] public int? PageNumber { get; set; }

    private int CurrentPage => Math.Max(1, PageNumber ?? 1);
    private string? searchText;
    private PagedResult<AcmeOrderSummary>? result;
    private bool loadFailed;

    protected override async Task OnParametersSetAsync()
    {
        searchText = Search;
        result = null;
        loadFailed = false;
        try
        {
            result = await CertificateRequestsApiClient.GetAcmeOrdersAsync(Search, Failing, CurrentPage, PageSize);
        }
        catch (Exception)
        {
            loadFailed = true;
        }
    }

    private void Navigate(string? search, bool failing, int page) =>
        Nav.NavigateTo(Nav.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["search"] = string.IsNullOrWhiteSpace(search) ? null : search,
            ["failing"] = failing ? true : null,
            ["page"] = page > 1 ? page : null,
        }));

    private Task SearchOnEnterAsync(KeyboardEventArgs args)
    {
        if (args.Key == "Enter") Navigate(searchText, Failing, 1);
        return Task.CompletedTask;
    }

    private Task ToggleFailingAsync(ChangeEventArgs args)
    {
        Navigate(searchText, args.Value is true, 1);
        return Task.CompletedTask;
    }

    private Task GoToPageAsync(int page)
    {
        Navigate(Search, Failing, page);
        return Task.CompletedTask;
    }
}
