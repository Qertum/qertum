    private async Task MigrateSecretStorageAsync()
    {
        migratingSecretStorage = true;
        secretStorageMigrationSucceeded = false;
        notificationMessage = null;

        try
        {
            await CertificateRequestsApiClient.MigrateSecretStorageAsync(targetProvider);
            secretStorageStatus = await CertificateRequestsApiClient.GetSecretStorageStatusAsync();
            secretStorageMigrationSucceeded = true;
            ShowNotification("Secret storage migrated. Restart the services for the change to take effect.", "success");
        }
        catch (Exception ex)
        {
            ShowNotification($"Failed to migrate secret storage: {ex.Message}", "danger");
        }
        finally
        {
            migratingSecretStorage = false;
        }
    }

    private void ShowNotification(string message, string type)
    {
        notificationMessage = message;
        notificationType = type;
    }

    private async Task DownloadCaCertAsync(string format)
    {
        try
        {
            var bytes = await CertificateRequestsApiClient.DownloadCaCertificateAsync(format);
            var (filename, mime) = format switch
            {
                "der" => ("ca.cer", "application/x-x509-ca-cert"),
                "p7b" => ("ca.p7b", "application/x-pkcs7-certificates"),
                _     => ("ca.pem", "application/x-pem-file")
            };
            await JS.InvokeVoidAsync("downloadFile", filename, mime, Convert.ToBase64String(bytes));
        }
        catch (Exception ex)
        {
            ShowNotification($"Download failed: {ex.Message}", "danger");
        }
    }
