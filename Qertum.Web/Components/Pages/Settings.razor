    protected override async Task OnInitializedAsync()
    {
        try
        {
            var settingsTask = CertificateRequestsApiClient.GetSettingsAsync();
            var caStatusTask = CertificateRequestsApiClient.GetCaStatusAsync();
            var secretStorageStatusTask = CertificateRequestsApiClient.GetSecretStorageStatusAsync();
            await Task.WhenAll(settingsTask, caStatusTask, secretStorageStatusTask);
            settings = settingsTask.Result;
            caStatus = caStatusTask.Result;
            secretStorageStatus = secretStorageStatusTask.Result;
            targetProvider = secretStorageStatus.CurrentProvider;
            allowedNetworks = ParseNetworks(settings.AcmeChallengeAllowedNetworksJson);
            eabKeys = [.. await CertificateRequestsApiClient.GetAcmeExternalAccountKeysAsync()];
            estCredentials = [.. await CertificateRequestsApiClient.GetEstEnrollmentCredentialsAsync()];
            templates = [.. await CertificateRequestsApiClient.GetCertificateTemplatesAsync()];
        }
        catch (Exception ex)
        {
            ShowNotification($"Failed to load settings: {ex.Message}", "danger");
        }

        try
        {
            recoveryStatus = await CertificateRequestsApiClient.GetRecoveryStatusAsync();
        }
        catch (Exception)
        {
            // Unknown must never read as "nothing to report": the panel says unavailable.
            recoveryStatusUnavailable = true;
        }
    }

