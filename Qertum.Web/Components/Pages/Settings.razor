    private static List<string> ParseNetworks(string? json)
    {
        if (string.IsNullOrWhiteSpace(json)) return [];
        try { return JsonSerializer.Deserialize<List<string>>(json) ?? []; }
        catch (JsonException) { return []; }
    }

    private void AddNetwork()
    {
        networkError = null;
        var entry = newNetworkEntry?.Trim();

        if (string.IsNullOrWhiteSpace(entry))
            return;

        // Same parse the server validator applies, so a bad entry is caught before saving.
        if (!IPNetwork.TryParse(entry, out _) && !IPAddress.TryParse(entry, out _))
        {
            networkError = $"'{entry}' is not a valid CIDR range or IP address.";
            return;
        }

        if (allowedNetworks.Contains(entry, StringComparer.OrdinalIgnoreCase))
        {
            networkError = $"'{entry}' is already in the list.";
            return;
        }

        allowedNetworks.Add(entry);
        newNetworkEntry = null;
    }

    private void RemoveNetwork(string entry)
    {
        allowedNetworks.Remove(entry);
        networkError = null;
    }

    private void OnNetworkKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter") AddNetwork();
    }

    private async Task SaveSettingsAsync()
    {
        if (settings == null) return;

        isSaving = true;
        notificationMessage = null;

        try
        {
            settings.AcmeChallengeAllowedNetworksJson =
                allowedNetworks.Count == 0 ? null : JsonSerializer.Serialize(allowedNetworks);

            settings = await CertificateRequestsApiClient.SetupOrUpdateSettingsAsync(settings);
            allowedNetworks = ParseNetworks(settings.AcmeChallengeAllowedNetworksJson);
            ShowNotification("Settings saved and applied.", "success");
        }
        catch (Exception ex)
        {
            ShowNotification($"Failed to save settings: {ex.Message}", "danger");
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task ResetCrlBaseAsync()
    {
