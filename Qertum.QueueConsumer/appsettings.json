{
  "Webhook": {
    "DeliveryPollIntervalSeconds": 10
  },
  "LifecycleEvents": {
    "DiagnosticRetentionDays": 30,
    "BufferingTimeLimitMs": 500
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  },
  "QueueConsumer": {
    "IdleDelayMs": 10000,
    "ProcessingDelayMs": 250,
    "ErrorDelayMs": 2000
  },
  "AutoRenewal": {
    "CheckIntervalHours": 24
  },
  "Notices": {
    "Enabled": true,
    "CheckIntervalMinutes": 60,
    "ExpiryDays": "30,14,7,1",
    "EscalationAfterHours": 24,
    "RetentionDays": 90
  },
  "BackgroundJobs": {
    "PollIntervalSeconds": 30,
    "MaxAttempts": 5,
    "RetryBaseDelaySeconds": 30,
    "MaxRetryDelaySeconds": 3600,
    "RetentionDays": 30,
    "ProcessingTimeoutMinutes": 30
  },
  "CrlRefresh": {
    "Enabled": true,
    "CheckIntervalMinutes": 15,
    "RefreshAtFraction": 0.5
  },
  "Acme": {
    "ExpiryCleanup": {
      "Enabled": true,
      "Interval": "01:00:00",
      "Retention": "7.00:00:00",
      "BatchSize": 500
    }
  },
  "Approvals": {
    "GrantWindowMinutes": 15,
    "RequestTtlHours": 24,
    "RetentionDays": 365
  },
  "BulkOperations": {
    "MaxItems": 10000,
    "PreviewTtlMinutes": 60,
    "RetentionDays": 365
  },
  "AuditLog": {
    "File": {
      "Enabled": true,
      "Path": "",
      "RollingInterval": "Day",
      "RetainedFileCountLimit": 365
    },
    "Checkpoint": {
      "Enabled": true,
      "IntervalMinutes": 60,
      "IdentityDirectory": ""
    }
  }
}
