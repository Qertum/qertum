@page
@model Qertum.IdentityService.Pages.Account.ChangePasswordModel
@{
    Layout = "/Pages/Shared/_AccountLayout.cshtml";
    ViewData["Title"] = "Change password";
    // Forced mode shows no account navigation — "Manage users" would be a link straight past
    // the block. Only the sign-out link survives, so a stuck user can still leave.
    ViewData["HideAccountNav"] = Model.Forced;
}

<form class="card" method="post">
    <h1>Change <em>password</em></h1>
    @if (Model.Forced)
    {
        <p class="card-sub">You must change your password before continuing.</p>
        <div class="error">
            <span class="bi bi-exclamation-triangle-fill"></span>
            <span>This account is still using its initial password. Pick a new one to continue.</span>
        </div>
        <input type="hidden" asp-for="Forced" />
        <input type="hidden" asp-for="ReturnUrl" />
    }
    else
    {
        <p class="card-sub">Enter your current password and pick a new one.</p>
    }

    <div class="field">
        <label asp-for="Input.CurrentPassword">Current password</label>
        <input asp-for="Input.CurrentPassword" type="password" autocomplete="current-password" autofocus placeholder="••••••••" />
    </div>

    <div class="field">
        <label asp-for="Input.NewPassword">New password</label>
        <input asp-for="Input.NewPassword" type="password" autocomplete="new-password" placeholder="••••••••" />
    </div>

    <div class="field">
        <label asp-for="Input.ConfirmPassword">Confirm new password</label>
        <input asp-for="Input.ConfirmPassword" type="password" autocomplete="new-password" placeholder="••••••••" />
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="error">
            <span class="bi bi-exclamation-triangle-fill"></span>
            <span>@Model.ErrorMessage</span>
        </div>
    }
    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="success">
            <span class="bi bi-check-circle-fill"></span>
            <span>@Model.StatusMessage</span>
        </div>
    }

    <button type="submit">
        <span class="bi bi-shield-lock"></span>
        Update password
    </button>
    @if (!Model.Forced)
    {
        <a class="button secondary" href="/Account">
            <span class="bi bi-arrow-left"></span>
            Back to profile
        </a>
    }
</form>
