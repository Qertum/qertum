{
  "IdentityService": {
    "Authority": "",
    "DataPath": null,
    "DisableTransportSecurity": false,
    "EnableServiceDiscoveryRedirectUris": null,
    "SeedTestClients": false,
    "SecretStorageProvider": null,
    "CertificateLifetimeDays": 1825,
    "CertificateRenewBeforeDays": 90,
    "CertificateRotationCheckHours": 24,
    "AuditLog": {
      "Enabled": true,
      "Path": null
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "OpenIddict": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
