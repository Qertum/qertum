<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <UserSecretsId>qertum-identityservice</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Lets Qertum.Tests drive IdentityCertificateStore's rotation directly with an injected
         clock, instead of waiting five years for a certificate to expire. -->
    <InternalsVisibleTo Include="Qertum.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Qertum.DesignSystem\Qertum.DesignSystem.csproj" />
    <ProjectReference Include="..\Qertum.ServiceDefaults\Qertum.ServiceDefaults.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OpenIddict.AspNetCore" />
    <PackageReference Include="OpenIddict.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <!-- Pin the patched native SQLite bundle: EF Core Sqlite transitively pulls
         SQLitePCLRaw 2.1.11, which has a high-severity vulnerability (GHSA-2m69-gcr7-jv3q,
         fixed in 3.x). -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Formatting.Compact" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="StackExchange.Redis" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Qertum.Audit\Qertum.Audit.csproj" />
  </ItemGroup>

</Project>
