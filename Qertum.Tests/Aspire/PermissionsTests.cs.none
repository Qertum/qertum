    [Fact(DisplayName = "IT-PERMS-005")]
    public async Task Permissions_Viewer_CannotCreate()
    {
        // Arrange
        // Ensure viewer has only certificates.view
        await fixture.ApiClientAsAdmin.PutAsJsonAsync("/permissions/viewer", new { Permissions = new[] { "certificates.view" } }, TestContext.Current.CancellationToken);

        // Act
        var resp = await fixture.ApiClientAsViewer.PostAsJsonAsync("/certificate-requests", new { CommonName = TestHelpers.UniqueCN(), RequestedBy = "v", Type = "WebServer", PropertiesJson = "{}" }, TestContext.Current.CancellationToken);

        // Assert
        Assert.Equal(HttpStatusCode.Forbidden, resp.StatusCode);
    }

    [Fact(DisplayName = "IT-PERMS-006")]
    public async Task Permissions_ViewerWithCreatePerm_CanCreate()
    {
        // Arrange
        // Give viewer create permission
        await fixture.ApiClientAsAdmin.PutAsJsonAsync("/permissions/viewer", new { Permissions = new[] { "certificates.view", "certificates.create" } }, TestContext.Current.CancellationToken);

        try
        {
            // Act
            var resp = await fixture.ApiClientAsViewer.PostAsJsonAsync("/certificate-requests", new { CommonName = TestHelpers.UniqueCN(), RequestedBy = "v", Type = "WebServer", PropertiesJson = "{}" }, TestContext.Current.CancellationToken);

            // Assert
            Assert.Equal(HttpStatusCode.Created, resp.StatusCode);
        }
        finally
        {
            // Restore viewer permissions
            await fixture.ApiClientAsAdmin.PutAsJsonAsync("/permissions/viewer", new { Permissions = new[] { "certificates.view" } }, TestContext.Current.CancellationToken);
        }
    }
}
